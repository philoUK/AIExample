{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-apphost",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/AppHost/AppHost.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "wait-for-api",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "while (-not (Get-Process -Name Api -ErrorAction SilentlyContinue)) { Start-Sleep -Milliseconds 500 }; Start-Sleep -Seconds 2"
            ],
            "problemMatcher": []
        }
    ]
}
